{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whisker-watch:deck:1",
  "title": "Whisker Watch multiple-choice deck v1",
  "description": "Structural validation only; no factual assessment. Unknown fields warned and discarded by application. Semantic uniqueness checks supplement JSON Schema.",
  "type": "object",
  "required": [
    "deckFormat",
    "deckType",
    "deckId",
    "questions"
  ],
  "properties": {
    "deckFormat": {
      "const": 1
    },
    "deckType": {
      "const": "multiple_choice"
    },
    "deckId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "notes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "maxLength": 8000
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "wrong"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "wrong": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 8000
          },
          "topic": {
            "type": "string",
            "maxLength": 200
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reviewStats": {
            "type": "object",
            "properties": {
              "correct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "incorrect": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "skipped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "seen": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
